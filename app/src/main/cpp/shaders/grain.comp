#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D pixelBuffer;

layout(push_constant) uniform PushConstants {
    float highlightSize;
    float highlightDensity;
    float midtoneSize;
    float midtoneDensity;
    float shadowSize;
    float shadowDensity;
    uint seed;
    uint width;
    uint height;
} pc;

float hash(vec2 p, uint s) {
    return fract(sin(dot(p + vec2(float(s) * 0.123), vec2(12.9898, 78.233))) * 43758.5453);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(pc.width) || pos.y >= int(pc.height)) return;

    vec4 color = imageLoad(pixelBuffer, pos);

    float lum = dot(color.rgb, vec3(0.299, 0.587, 0.114));

    float grainDensity, grainSize;
    if (lum > 0.66) {
        grainDensity = pc.highlightDensity;
        grainSize = pc.highlightSize;
    } else if (lum > 0.33) {
        grainDensity = pc.midtoneDensity;
        grainSize = pc.midtoneSize;
    } else {
        grainDensity = pc.shadowDensity;
        grainSize = pc.shadowSize;
    }

    if (grainDensity > 0.0) {
        float rnd = hash(vec2(float(pos.x), float(pos.y)), pc.seed);
        float noise = (rnd - 0.5) * (grainDensity / 100.0) * 50.0 * (1.0 + grainSize / 100.0);
        // Normalize noise to [0,1] range (divide by 255 equivalent)
        noise /= 255.0;
        color.rgb += noise;
    }

    imageStore(pixelBuffer, pos, clamp(color, 0.0, 1.0));
}
