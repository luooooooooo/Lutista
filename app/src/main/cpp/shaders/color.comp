#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D pixelBuffer;

layout(push_constant) uniform PushConstants {
    float saturation;
    float colorTemperature;
    float tint;
    uint width;
    uint height;
} pc;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(pc.width) || pos.y >= int(pc.height)) return;

    vec4 color = imageLoad(pixelBuffer, pos);

    // Saturation
    if (pc.saturation != 0.0) {
        float gray = dot(color.rgb, vec3(0.299, 0.587, 0.114));
        float factor = 1.0 + pc.saturation / 100.0;
        color.rgb = gray + (color.rgb - gray) * factor;
    }

    // Color temperature: warm = +R/-B
    if (pc.colorTemperature != 0.0) {
        float adj = pc.colorTemperature / 200.0;
        color.r += adj;
        color.b -= adj;
    }

    // Tint: +G
    if (pc.tint != 0.0) {
        float adj = pc.tint / 200.0;
        color.g += adj;
    }

    imageStore(pixelBuffer, pos, clamp(color, 0.0, 1.0));
}
