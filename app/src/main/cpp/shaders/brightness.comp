#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D pixelBuffer;

layout(push_constant) uniform PushConstants {
    float exposure;
    float contrast;
    float highlights;
    float shadows;
    uint width;
    uint height;
} pc;

// sRGB <-> linear（曝光必须在线性空间换算，否则感知增益被 gamma 放大成 2^(2.2*EV)）
vec3 srgbToLinear(vec3 s) {
    return mix(s / 12.92, pow((s + 0.055) / 1.055, vec3(2.4)), step(0.04045, s));
}
vec3 linearToSrgb(vec3 l) {
    return mix(l * 12.92, 1.055 * pow(l, vec3(1.0/2.4)) - 0.055, step(0.0031308, l));
}

// 与 unified.comp 的 applyExposure() 完全一致：线性域增益 + 扩展 Reinhard 高光肩部，
// 白点 W 钉在增益上，保证纯白 +EV 之后仍然是白，而不是发灰或硬切成死白。
const float MAX_ROLLOFF_GAIN = 4.0;

vec3 applyExposure(vec3 srgb, float ev) {
    float gain = exp2(ev);
    float w = clamp(gain, 1.0, MAX_ROLLOFF_GAIN);
    vec3 lin = srgbToLinear(clamp(srgb, 0.0, 1.0)) * gain;
    lin = lin * (1.0 + lin / (w * w)) / (1.0 + lin);
    return linearToSrgb(clamp(lin, 0.0, 1.0));
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(pc.width) || pos.y >= int(pc.height)) return;

    vec4 color = imageLoad(pixelBuffer, pos);

    // Exposure: 线性域增益 + 高光肩部（EV == 0 直接跳过，保证恒等）
    if (pc.exposure != 0.0) {
        color.rgb = applyExposure(color.rgb, pc.exposure);
    }

    // Contrast: scale around midpoint
    if (pc.contrast != 0.0) {
        float factor = (100.0 + pc.contrast) / 100.0;
        color.rgb = (color.rgb - 0.5) * factor + 0.5;
    }

    // Highlights/shadows: luminance-based
    if (pc.highlights != 0.0 || pc.shadows != 0.0) {
        float lum = dot(color.rgb, vec3(0.299, 0.587, 0.114));
        if (lum > 0.5 && pc.highlights != 0.0) {
            float adj = (pc.highlights / 100.0) * lum * 0.5;
            color.rgb += adj;
        } else if (lum <= 0.5 && pc.shadows != 0.0) {
            float adj = (pc.shadows / 100.0) * (1.0 - lum) * 0.5;
            color.rgb += adj;
        }
    }

    imageStore(pixelBuffer, pos, clamp(color, 0.0, 1.0));
}
