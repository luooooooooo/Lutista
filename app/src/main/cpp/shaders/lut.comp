#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D pixelBuffer;
layout(set = 0, binding = 1) uniform sampler3D lutSampler;

layout(push_constant) uniform PushConstants {
    float concentration;
    uint width;
    uint height;
} pc;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(pc.width) || pos.y >= int(pc.height)) return;

    vec4 color = imageLoad(pixelBuffer, pos);

    // 3D texture lookup with hardware trilinear interpolation
    // Coordinate mapping: x=R, y=G, z=B (matches LutParser storage order)
    vec3 lutResult = texture(lutSampler, color.rgb).rgb;
    color.rgb = mix(color.rgb, lutResult, pc.concentration);

    imageStore(pixelBuffer, pos, clamp(color, 0.0, 1.0));
}
