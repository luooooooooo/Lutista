#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform image2D pixelBuffer;

// 8 color zones × 3 adjustments (lightness, chroma, hue)
// Zone order: red, orange, yellow, green, cyan, blue, purple, skin
layout(push_constant) uniform PushConstants {
    float adjustments[24]; // 8 * 3
    uint width;
    uint height;
} pc;

const float PI = 3.14159265359;

// Approximate hue center for each zone (in radians)
const float ZONE_CENTERS[8] = float[8](
    0.0,            // red ~0°
    PI / 6.0,       // orange ~30°
    PI / 3.0,       // yellow ~60°
    2.0*PI / 3.0,   // green ~120°
    PI,              // cyan ~180°
    4.0*PI / 3.0,   // blue ~240°
    5.0*PI / 3.0,   // purple ~300°
    PI / 7.0         // skin ~25°
);

const float ZONE_WIDTH = PI / 6.0; // ±30° from center

vec3 rgbToLch(vec3 rgb) {
    float l = 0.299 * rgb.r + 0.587 * rgb.g + 0.114 * rgb.b;
    float a = rgb.r - rgb.g;
    float b = (rgb.r + rgb.g) / 2.0 - rgb.b;
    float c = sqrt(a * a + b * b);
    float h = atan(b, a); // returns [-PI, PI]
    if (h < 0.0) h += 2.0 * PI; // normalize to [0, 2PI]
    return vec3(l, c, h);
}

vec3 lchToRgb(vec3 lch) {
    float a = lch.y * cos(lch.z);
    float b = lch.y * sin(lch.z);
    float r = lch.x + a;
    float g = lch.x - a / 2.0 + b / 2.0;
    float bl = lch.x - a / 2.0 - b / 2.0;
    return vec3(r, g, bl);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= int(pc.width) || pos.y >= int(pc.height)) return;

    vec4 color = imageLoad(pixelBuffer, pos);

    vec3 lch = rgbToLch(color.rgb);
    float totalWeight = 0.0;
    float deltaL = 0.0, deltaC = 0.0, deltaH = 0.0;

    for (int zone = 0; zone < 8; zone++) {
        float center = ZONE_CENTERS[zone];
        float diff = abs(lch.z - center);
        if (diff > PI) diff = 2.0 * PI - diff; // wrap around

        if (diff < ZONE_WIDTH) {
            float weight = 1.0 - diff / ZONE_WIDTH; // smooth falloff
            weight *= weight; // quadratic falloff

            float adjL = pc.adjustments[zone * 3]     / 100.0;
            float adjC = pc.adjustments[zone * 3 + 1] / 100.0;
            float adjH = pc.adjustments[zone * 3 + 2] / 100.0;

            deltaL += adjL * weight;
            deltaC += adjC * weight;
            deltaH += adjH * weight;
            totalWeight += weight;
        }
    }

    if (totalWeight > 0.0) {
        lch.x = clamp(lch.x + deltaL, 0.0, 1.0);
        lch.y = max(lch.y + deltaC, 0.0);
        lch.z += deltaH;
        if (lch.z < 0.0) lch.z += 2.0 * PI;
        if (lch.z >= 2.0 * PI) lch.z -= 2.0 * PI;

        color.rgb = lchToRgb(lch);
    }

    imageStore(pixelBuffer, pos, clamp(color, 0.0, 1.0));
}
